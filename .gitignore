# Captures contain the credential in cleartext (Authorization header and the
# request body both carry the session token). Never commit them.
captures/
captures-relay/
captures-*/

# Generated at first run; holds the proxy API key.
config.json

# The dashboard's own state: a hash of its password, and the account tokens it was
# given. Written beside config.json, 0600.
dashboard.json
dashboard.json.tmp
*.tmp

# The TLS material the server generates at runtime beside the config. The
# private key is a credential; the certificate is public anyway, but shipping
# one from the repo would be the wrong one.
tls.crt
tls.key

# Compose/env files holding real deployment secrets (API key, Devin token,
# dashboard password). compose.yaml itself references these by name only.
.env
.env.*

# Recorded backend status responses used as offline fixtures (devin-status
# -save, zero-quota-fixture.mjs). bin/ covers them when they land there; this
# catches one written at the repository root instead.
*.bin

# Account token lists hold a live credential per line, in cleartext. bin/ is
# already ignored, which covers the files tools/make-pool-tokens.mjs writes; these
# patterns catch one a user keeps at the repository root instead.
tokens*.txt
*-tokens.txt
accounts*.txt

bin/
*.exe
*.test
*.out

# Scratch from ad-hoc runs and probes: server logs, editor backups, the relay's
# websocket working dir. bin/ already covers these when they land there; these
# patterns catch one written at the repository root instead.
*.log
*.log~
*~
.probe-ws/

# The OpenAI SDK compatibility test in tools/ pulls this in locally.
node_modules/
package-lock.json

# variants.json is generated by tools/make-variants.mjs from a REAL session
# token: the tampered-signature variants still carry the live session id in
# their JWT payload. Regenerate locally; never commit.
tools/variants.json

# Local agent/tool session data (plans, scratch) — not part of the project.
.zcode/
.zcodeignore

.DS_Store
Thumbs.db
desktop.ini
